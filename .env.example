# Dashboard data source. Leave empty to run on simulated data;
# set to /api to show what the devices POST to this app's endpoints.
NEXT_PUBLIC_SENTINEL_API_URL=
# How often the dashboard polls, in ms.
NEXT_PUBLIC_SENTINEL_POLL_MS=2000
# Optional shared secret. When set, device writes must send it as the x-api-key header.
SENTINEL_INGEST_KEY=
# SQLite file location (default: data/sentinel.db).
SENTINEL_DB_PATH=
