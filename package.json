{
  "name": "sb-scaffold",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sim:seed": "node -e \"fetch(process.env.SENTINEL_URL||'http://localhost:3000/api/simulate',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({action:'seed',minutes:Number(process.argv[1]||25),reset:true})}).then(r=>r.json()).then(j=>console.log(JSON.stringify(j,null,2)))\" --",
    "sim:start": "node -e \"fetch(process.env.SENTINEL_URL||'http://localhost:3000/api/simulate',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({action:'start'})}).then(r=>r.json()).then(j=>console.log(JSON.stringify(j,null,2)))\"",
    "sim:stop": "node -e \"fetch(process.env.SENTINEL_URL||'http://localhost:3000/api/simulate',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({action:'stop'})}).then(r=>r.json()).then(j=>console.log(JSON.stringify(j,null,2)))\"",
    "sim:status": "node -e \"fetch(process.env.SENTINEL_URL||'http://localhost:3000/api/simulate').then(r=>r.json()).then(j=>console.log(JSON.stringify(j,null,2)))\""
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.0",
    "@types/three": "^0.186.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.2",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
